{
  "name": "todo-gpt",
  "version": "1.0.0",
  "description": "AI-powered project assistant with calendar integration",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "test": "jest",
    "build": "webpack --mode production",
    "docker:build": "docker build -t todo-gpt .",
    "docker:run": "docker run -p 3000:3000 --env-file .env todo-gpt",
    "docker:compose": "docker-compose up -d",
    "docker:logs": "docker-compose logs -f",
    "docker:stop": "docker-compose down"
  },
  "dependencies": {
    "express": "^4.18.2",
    "socket.io": "^4.7.2",
    "node-cron": "^3.0.2",
    "openai": "^4.20.1",
    "@octokit/rest": "^20.0.2",
    "google-calendar": "^1.3.2",
    "fs-extra": "^11.1.1",
    "axios": "^1.5.0",
    "multer": "^1.4.5-lts.1",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.1",
    "jest": "^29.7.0",
    "supertest": "^6.3.3",
    "webpack": "^5.88.2",
    "webpack-cli": "^5.1.4",
    "mock-fs": "^5.2.0"
  },
  "keywords": ["ai", "automation", "calendar", "development", "assistant"],
  "author": "Todo-GPT Team",
  "license": "MIT"
}