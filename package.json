{
  "name": "sprintops",
  "version": "1.0.0",
  "description": "SprintOps - Autonomous Agile & Development Agent Platform",
  "main": "main.js",
  "scripts": {
    "start": "node src/index.js",
    "desktop": "electron .",
    "dev": "nodemon src/index.js",
    "test": "jest",
    "build": "webpack --mode production",
    "docker:build": "docker build -t sprintops .",
    "docker:run": "docker run -p 3000:3000 --env-file .env sprintops",
    "docker:compose": "docker-compose up -d",
    "docker:logs": "docker-compose logs -f",
    "docker:stop": "docker-compose down"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@octokit/rest": "^20.0.2",
    "axios": "^1.5.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "fs-extra": "^11.1.1",
    "google-calendar": "^1.3.2",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^3.0.2",
    "openai": "^4.20.1",
    "socket.io": "^4.7.2",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.0"
  },
  "devDependencies": {
    "electron": "^41.2.1",
    "jest": "^29.7.0",
    "mock-fs": "^5.2.0",
    "nodemon": "^3.0.1",
    "supertest": "^6.3.3",
    "webpack": "^5.88.2",
    "webpack-cli": "^5.1.4"
  },
  "keywords": [
    "ai",
    "sprintops",
    "agile",
    "automation",
    "development"
  ],
  "author": "SprintOps Team",
  "license": "MIT"
}
